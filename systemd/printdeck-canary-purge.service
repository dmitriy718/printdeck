[Unit]
Description=PrintDeck 5-Minute A9 Canary Order Purger & External HTTP 200 Canary
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/dima/Projects/printdeck
EnvironmentFile=-/home/dima/Projects/printdeck/.env.cluster
EnvironmentFile=-/home/dima/Projects/printdeck/.env.automations
ExecStart=/home/dima/Projects/printdeck/.venv/bin/python3 /home/dima/Projects/printdeck/autonomous_empire_daemon.py --canary-purge
