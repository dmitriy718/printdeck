[Unit]
Description=Para Autonomous Commander & PrintDeck Herdr Telemetry Bridge
After=network-online.target herdr.service

[Service]
Type=oneshot
WorkingDirectory=/home/dima/Projects/printdeck
EnvironmentFile=-/home/dima/Projects/printdeck/.env.cluster
EnvironmentFile=-/home/dima/Projects/printdeck/.env.automations
ExecStart=/home/dima/Projects/printdeck/.venv/bin/python3 /home/dima/Projects/printdeck/herdr_commander_bridge.py
